          { "matcher": { "id": "byName", "options": "Mercedes" }, "properties": [{ "id": "color", "value": { "fixedColor": "#27F4D2", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Red Bull" }, "properties": [{ "id": "color", "value": { "fixedColor": "#3671C6", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Ferrari" }, "properties": [{ "id": "color", "value": { "fixedColor": "#E8002D", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "McLaren" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF8000", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Aston Martin" }, "properties": [{ "id": "color", "value": { "fixedColor": "#229971", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "F1-PostgreSQL" },
          "format": "table",
          "rawSql": "SELECT t.team_name AS \"Constructor\", SUM(f.points) AS \"Points\"\nFROM fact_race_results f\nJOIN dim_team t ON f.team_id = t.team_id\nJOIN dim_race r ON f.race_id = r.race_id\nWHERE r.season_year = ${season}\nGROUP BY t.team_name\nORDER BY \"Points\" ASC;",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "postgres", "uid": "F1-PostgreSQL" },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 1 },
      "id": 302,
      "title": "Team Race Wins & Podiums Breakdown",
      "type": "table",
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Points" }]
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "F1-PostgreSQL" },
          "format": "table",
          "rawSql": "SELECT \n  t.team_name AS \"Constructor\",\n  t.engine_supplier AS \"Engine\",\n  SUM(f.points) AS \"Points\",\n  SUM(f.is_win) AS \"Wins\",\n  SUM(f.is_podium) AS \"Podiums\",\n  SUM(f.is_pole) AS \"Poles\"\nFROM fact_race_results f\nJOIN dim_team t ON f.team_id = t.team_id\nJOIN dim_race r ON f.race_id = r.race_id\nWHERE r.season_year = ${season}\nGROUP BY t.team_name, t.engine_supplier\nORDER BY \"Points\" DESC;",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 303,
      "title": "⏱️ Pit Stop Efficiency & Crew Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "F1-PostgreSQL" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 11 },
      "id": 304,
      "title": "Average Pit Duration vs Fastest Recorded Pit Stop (Seconds)",
      "type": "bargauge",
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 24 },
              { "color": "red", "value": 27 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "F1-PostgreSQL" },
          "format": "table",
          "rawSql": "SELECT \n  t.team_name AS \"Constructor\",\n  ROUND(AVG(f.total_pit_time_ms / 1000.0 / NULLIF(f.pit_stop_count, 0)), 2) AS \"Avg Pit Stop (s)\"\nFROM fact_race_results f\nJOIN dim_team t ON f.team_id = t.team_id\nJOIN dim_race r ON f.race_id = r.race_id\nWHERE r.season_year = ${season} AND f.pit_stop_count > 0\nGROUP BY t.team_name\nORDER BY \"Avg Pit Stop (s)\" ASC;",
          "refId": "A"
        }
      ]
    }
  ],
